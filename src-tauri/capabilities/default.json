{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口：自绘标题栏的窗口操作（destroy 用于关窗前先保存历史记录）；网络请求允许所有公网 http/https（研究 Agent 按需读取来源网页全文），本机与内网地址拒绝，重定向逐跳检查（tauri.conf.json 的 scopeRedirects）；外链交给系统浏览器",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ],
      "deny": [
        {
          "url": "http://localhost"
        },
        {
          "url": "http://*.localhost"
        },
        {
          "url": "http://*.local"
        },
        {
          "url": "http://*.internal"
        },
        {
          "url": "http://127.*"
        },
        {
          "url": "http://10.*"
        },
        {
          "url": "http://192.168.*"
        },
        {
          "url": "http://169.254.*"
        },
        {
          "url": "http://0.*"
        },
        {
          "url": "http://172.16.*"
        },
        {
